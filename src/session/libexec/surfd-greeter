#!/usr/bin/bash
# surfd-greeter — the login screen: gtkgreet inside a minimal Sway.
# Run by greetd as the surfd-greeter user.
set -u

# Use the keyboard layout chosen in the installer (localectl).
kb=/etc/X11/xorg.conf.d/00-keyboard.conf
if [[ -r "${kb}" ]]; then
    get() { sed -n "s/.*Option[[:space:]]*\"$1\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" "${kb}" | head -n1; }
    layout="$(get XkbLayout)"; variant="$(get XkbVariant)"; options="$(get XkbOptions)"
    [[ -n "${layout}" ]] && export XKB_DEFAULT_LAYOUT="${layout}"
    [[ -n "${variant}" ]] && export XKB_DEFAULT_VARIANT="${variant}"
    [[ -n "${options}" ]] && export XKB_DEFAULT_OPTIONS="${options}"
fi

# If the graphical login screen cannot run, never leave a dead screen: fall
# back to greetd's text login, which can still start the surfd session.
text_login() {
    echo "surfd-greeter: $1; using the text login instead" >&2
    printf '\nsurfd: the graphical login screen could not start (%s).\n' "$1"
    printf 'Log in below; details: journalctl -b -u greetd\n\n'
    exec agreety --cmd surfd-session
}

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    text_login "no XDG_RUNTIME_DIR: no login session (is the system bus, dbus-broker, running?)"
fi

export XDG_SESSION_TYPE=wayland
args=()
[[ -d /sys/module/nvidia ]] && args+=(--unsupported-gpu)
started=${SECONDS}
sway "${args[@]}" --config /etc/surfd/greetd/sway-config
status=$?
# A login ends the greeter normally (status 0). Dying within seconds means Sway could not start.
if (( status != 0 && SECONDS - started < 10 )); then
    text_login "Sway exited with status ${status}"
fi
exit "${status}"
