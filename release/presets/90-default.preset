# surfd general system defaults (replaces the preset policy that
# fedora-release-common normally ships). Review after Fedora upgrades:
#   systemctl list-unit-files --state=enabled
enable atd.service
enable crond.service
enable irqbalance.service
enable lvm2-monitor.service
enable lvm2-lvmpolld.socket
enable dm-event.socket
enable mdmonitor.service
enable multipathd.socket
enable smartd.service
enable sssd.service
enable systemd-oomd.service
enable systemd-pstore.service
enable systemd-boot-update.service
enable udisks2.service
enable accounts-daemon.service
enable avahi-daemon.socket
enable avahi-daemon.service
enable ModemManager.service
enable rtkit-daemon.service
enable upower.service
enable pcscd.socket
enable uuidd.socket
enable fstrim.timer
enable logrotate.timer
enable raid-check.timer
enable unbound-anchor.timer
enable dnf-makecache.timer
enable selinux-autorelabel-mark.service
enable import-state.service
enable loadmodules.service
enable nis-domainname.service
enable rpcbind.socket
enable remote-fs.target
enable remote-cryptsetup.target
enable machines.target
enable getty@.service
enable reboot.target
enable spice-vdagentd.socket
enable qemu-guest-agent.service
enable vboxservice.service
enable vmtoolsd.service
enable hypervkvpd.service
enable hypervvssd.service
enable hypervfcopyd.service
enable mcelog.service
enable iscsi.service
enable iscsid.socket
enable iscsiuio.socket
enable bolt.service
enable zram-swap.service
