# surfd — EXPERIMENTAL atomic (image-based) variant built with bootc.
#
# Build the surfd RPMs first, then the image:
#   ./build.sh rpms
#   ./build.sh container          # = podman build -f containers/Containerfile .
# Turn it into an installable ISO or disk image with bootc-image-builder;
# see containers/README.md.
ARG FEDORA_VERSION=44
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

COPY out/repo /tmp/surfd-repo
COPY containers/packages-x86_64.txt containers/packages-aarch64.txt /tmp/

# One package set with the ISO: generated from the kickstarts.
RUN set -eux; \
    arch="$(uname -m)"; \
    grep -v '^#' "/tmp/packages-${arch}.txt" > /tmp/packages.txt; \
    xargs -a /tmp/packages.txt dnf -y install --setopt=install_weak_deps=False \
        --repofrompath=surfd-local,file:///tmp/surfd-repo --setopt=surfd-local.gpgcheck=0 \
        --allowerasing; \
    dnf -y remove fedora-logos fedora-release-identity-basic 2>/dev/null || true; \
    systemctl enable greetd.service surfd-flathub.service; \
    ln -sf /usr/lib/systemd/system/greetd.service /etc/systemd/system/display-manager.service; \
    systemctl set-default graphical.target; \
    plymouth-set-default-theme surfd; \
    dnf clean all; \
    rm -rf /tmp/surfd-repo /tmp/packages*.txt /var/cache/* /var/log/*

# Fail the build early if the image is not a valid bootc image.
RUN bootc container lint
